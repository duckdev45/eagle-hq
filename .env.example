NEXT_PUBLIC_APP_ENV=          # DEV, QAS, or PRD
NEXT_PUBLIC_SITE_URL=         # App public URL
NEXT_PUBLIC_API_BASE_URL=     # Backend API endpoint

# ── Jira sync (server-only, never NEXT_PUBLIC) ──
JIRA_BASE_URL=                # https://your-org.atlassian.net
JIRA_USER_EMAIL=              # Atlassian account email
JIRA_API_TOKEN=               # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=QMS
JIRA_TBC_STUCK_DAYS=3# 卡在 TBC 幾天 → 紅燈
JIRA_VERIFY_STUCK_DAYS=2# VERIFY 幾天未推進 → 黃燈
CRON_SECRET=                  # /api/sync 的 Bearer token（Vercel Cron 自動帶上）
# BLOB_READ_WRITE_TOKEN=      # Vercel Blob（production snapshot 儲存；本機免設，寫 .cache/）
# ANTHROPIC_API_KEY=          # Phase 2 LLM 判斷用
